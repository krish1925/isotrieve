{
    "name": "@isotrieve/demo-cli",
    "version": "1.0.0",
    "description": "Zero-friction CLI demo for Isotrieve",
    "main": "dist/index.js",
    "bin": {
        "isotrieve-demo": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "isotrieve",
        "embeddings",
        "demo",
        "cli"
    ],
    "author": "Isotrieve Team",
    "license": "MIT",
    "dependencies": {
        "@isotrieve/core": "*",
        "commander": "^11.0.0",
        "chalk": "^4.1.2",
        "ora": "^5.4.1",
        "cli-table3": "^0.6.3",
        "@xenova/transformers": "^2.14.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "ts-node": "^10.9.1",
        "@types/node": "^20.0.0",
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": ["**/__tests__/**/*.test.ts"],
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/**/*.d.ts",
            "!src/__tests__/**",
            "!src/index.ts"
        ]
    },
    "files": [
        "dist",
        "README.md"
    ]
}
